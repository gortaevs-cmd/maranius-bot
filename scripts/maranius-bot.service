[Unit]
Description=Maranius Telegram Bot (polling + SOCKS)
After=network-online.target telegram-socks-tunnel.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/apps/maranius
ExecStart=/opt/apps/maranius/.venv/bin/python bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
