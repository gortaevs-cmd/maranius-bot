# Какой бот запускать: test (@angelic_signs_bot) или prod (@maraniusbot).
# На Mac обычно: BOT_PROFILE=test
BOT_PROFILE=test

# Токены от BotFather
BOT_TOKEN_TEST=токен_стенда_angelic_signs
BOT_TOKEN_PROD=токен_боевого_maraniusbot

# Карта дня / кристалл — maranius.ru (каталог data/daily_practice_catalog.json)
# CARD_OF_DAY_BASE_URL=https://maranius.ru/karta-dnya

# Hip prod: polling через SOCKS-туннель (telegram-socks-tunnel на localhost:1080).
# На Mac не задавать — иначе бот ищет локальный 1080.
# TELEGRAM_PROXY_URL=socks5h://127.0.0.1:1080
