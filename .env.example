# Только боевой @MaraniusBOT. Локально bot.py не запускать — работает контейнер на TimeWeb.
BOT_PROFILE=prod
BOT_TOKEN_PROD=токен_боевого_maraniusbot

# Карта дня — отдельная страница; кристалл — якорь на странице кристаллов.
# Каталог: data/daily_practice_catalog.json
# CARD_OF_DAY_BASE_URL=https://maranius.ru/practice/podskazki
# CRYSTAL_OF_DAY_BASE_URL=https://maranius.ru/themes/kristally

# На TimeWeb Docker-версия использует SOCKS-туннель автоматически;
# строка в compose переопределяет этот параметр на host.docker.internal:1080.
# На Mac не задавать — иначе бот ищет локальный 1080.
# TELEGRAM_PROXY_URL=socks5h://127.0.0.1:1080
